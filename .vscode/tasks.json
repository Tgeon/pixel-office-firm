{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🏢 Start the office (localhost:8787)",
      "type": "shell",
      "command": "uv run uvicorn office.server:app --port 8787 --reload --timeout-graceful-shutdown 3",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "🧪 Unit tests",
      "type": "shell",
      "command": "uv run pytest tests/ -q",
      "problemMatcher": []
    },
    {
      "label": "🔥 Live smoke test (all 23 dataflow commands)",
      "type": "shell",
      "command": "uv run python scripts/smoke_test.py",
      "problemMatcher": []
    },
    {
      "label": "🎬 Stage demo events (animate the floor, no LLM cost)",
      "type": "shell",
      "command": "uv run python scripts/demo_events.py",
      "problemMatcher": []
    },
    {
      "label": "🎬 Clear demo run",
      "type": "shell",
      "command": "uv run python scripts/demo_events.py clear",
      "problemMatcher": []
    },
    {
      "label": "🖼 Regenerate character sprites",
      "type": "shell",
      "command": "uv run python scripts/make_sprites.py",
      "problemMatcher": []
    },
    {
      "label": "📦 Refresh static datasets (OICA/IEA)",
      "type": "shell",
      "command": "uv run python -m dataflows industry refresh",
      "problemMatcher": []
    }
  ]
}

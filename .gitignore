# Secrets
.env

# Data (cache + static datasets are regenerable) — keep dir structure via .gitkeep
data/*
!data/cache/
data/cache/*
!data/cache/.gitkeep
!data/static/
data/static/*
!data/static/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
# .vscode is intentionally committed: shared settings, tasks, and
# recommended extensions make the project one-click for visitors

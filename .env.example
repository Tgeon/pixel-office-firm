# Copy to .env and fill in. All keys are free-tier signups.
# .env is gitignored — never commit real keys.

# Finnhub — https://finnhub.io/register (60 calls/min free)
FINNHUB_API_KEY=

# FRED — https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Reddit script app — https://www.reddit.com/prefs/apps (create "script" type app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pixel-office-firm/0.1 by <your_reddit_username>

# No keys needed: yfinance, SEC EDGAR, Google News RSS, NHTSA, OICA/IEA CSVs
# EDGAR requires a User-Agent identifying you (set your email):
EDGAR_IDENTITY=your.email@example.com
